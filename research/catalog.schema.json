{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qingbo1011/memxplore/research/catalog.schema.json",
  "title": "MemXplore research catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot", "entries"],
  "properties": {
    "$schema": {"const": "./catalog.schema.json"},
    "schema_version": {"const": 1},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "published_at", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
        "published_at": {"type": "string", "format": "date-time"},
        "review_status": {"enum": ["proposal", "reviewed"]}
      }
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "artifact_type", "version", "taxonomy", "status", "implementation", "upstream", "benchmarks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
        "title": {"type": "string", "minLength": 1},
        "artifact_type": {"enum": ["survey", "paper", "framework", "strategy", "benchmark", "dataset"]},
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "published_at"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "published_at": {"type": ["string", "null"], "format": "date"},
            "identifier": {"type": ["string", "null"]},
            "url": {"type": ["string", "null"], "format": "uri"}
          }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forms", "functions", "dynamics", "tags"],
          "properties": {
            "forms": {"type": "array", "items": {"enum": ["token-flat", "token-planar", "token-hierarchical", "parametric", "latent"]}, "uniqueItems": true},
            "functions": {"type": "array", "items": {"enum": ["factual", "experiential", "working"]}, "uniqueItems": true},
            "dynamics": {"type": "array", "items": {"enum": ["formation", "evolution", "retrieval"]}, "uniqueItems": true},
            "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true}
          }
        },
        "status": {"enum": ["cataloged", "planned", "implemented", "validated", "deferred"]},
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fidelity", "path", "limitations"],
          "properties": {
            "type": {"enum": ["baseline", "reference", "adapter", "experimental", "reproduction", "source-only"]},
            "fidelity": {"enum": ["none", "conceptual", "protocol-compatible", "result-verified"]},
            "path": {"type": ["string", "null"]},
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "license", "verification_status"],
          "properties": {
            "repository": {"type": ["string", "null"], "format": "uri"},
            "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "license": {"type": ["string", "null"]},
            "verification_status": {"enum": ["not-applicable", "pending", "verified"]}
          }
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "role": {"enum": ["reported", "planned", "smoke", "full", "ablation"]},
              "status": {"enum": ["not-run", "passed", "failed", "partial"]}
            }
          }
        }
      }
    }
  }
}
